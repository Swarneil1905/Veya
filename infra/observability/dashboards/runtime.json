{
  "uid": "veya-runtime",
  "title": "Veya runtime operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "veya"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 99,
      "title": "Interpretation",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Unknown cost is a count of calls, never a zero-dollar estimate. Empty/NaN panels mean no telemetry or no denominator. Cancelled attempts remain in denominators; failed, rejected and unknown attempts count as failures. Queue admission rejects overflow without retaining pending work. This dashboard contains operation aggregates, never document content."
      }
    },
    {
      "id": 1,
      "title": "Failure ratio by source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veya-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "veya:failure_ratio:rate5m",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Attempt latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veya-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "veya:latency_p95:5m",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
