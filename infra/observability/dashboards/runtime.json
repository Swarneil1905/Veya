      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veya-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (source) (veya_active_operations)",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
